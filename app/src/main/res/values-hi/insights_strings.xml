<resources>
    <string name="insights_title">विस्तृत आँकड़े</string>
    <string name="insights_description">वैकल्पिक सुनने का संदर्भ, जो इसी डिवाइस पर रहता है</string>
    <string name="insights_intro_title">डिफ़ॉल्ट रूप से बंद</string>
    <string name="insights_intro_body">हर प्ले के बारे में ज़्यादा जानकारी रिकॉर्ड करने के लिए इसे चालू करें, ताकि Aetheria दिखा सके कि आप कब, कैसे और किस पर सुनते हैं। यह सेटअप पूरा होने तक कुछ भी रिकॉर्ड नहीं होता।</string>
    <string name="insights_guide_title">त्वरित गाइड</string>
    <string name="insights_step_recorded_title">क्या रिकॉर्ड होता है</string>
    <string name="insights_step_recorded_body">आप कब और कितनी देर सुनते हैं, ट्रैक पूरा सुना गया या छोड़ा गया, उसकी शैली और स्रोत, और शफ़ल चालू था या नहीं।</string>
    <string name="insights_step_extras_title">अतिरिक्त जानकारी चुनें</string>
    <string name="insights_step_extras_body">नीचे तय करें कि आउटपुट डिवाइस और ऑडियो पाथ शामिल करें या नहीं। इसे कभी भी बदला जा सकता है।</string>
    <string name="insights_step_private_title">सब कुछ आपके फ़ोन पर रहता है</string>
    <string name="insights_step_private_body">केवल इसी डिवाइस पर सहेजा जाता है, कभी अपलोड नहीं होता और क्लाउड बैकअप से बाहर रहता है। निजी सत्र रिकॉर्डिंग रोक देता है, और आप कभी भी सब कुछ हटा सकते हैं।</string>
    <string name="insights_extras_title">अतिरिक्त जानकारी</string>
