    <string name="insights_step_recorded_title">What gets recorded</string>
    <string name="insights_step_recorded_body">When and how long you listen, whether a track was finished or skipped, its genre and source, and whether shuffle was on.</string>
    <string name="insights_step_extras_title">Choose the extra details</string>
    <string name="insights_step_extras_body">Decide below whether to include your output device and audio path. You can change this at any time.</string>
    <string name="insights_step_private_title">It stays on this phone</string>
    <string name="insights_step_private_body">Stored only on this device, never uploaded and left out of cloud backups. Private session pauses recording, and you can delete everything at any time.</string>
